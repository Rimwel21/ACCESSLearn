# Local development defaults. Never place real production secrets in this file.
DATABASE_URL=sqlite:///./local.db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=7

ENVIRONMENT=development
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
ENABLE_HSTS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_MIGRATE_ON_STARTUP=true
MAX_MATERIAL_UPLOAD_MB=25
MAX_PROFILE_IMAGE_UPLOAD_MB=5

CLOUD_NAME=replace-me
API_KEY=replace-me
API_SECRET=replace-me

MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.invalid
MAIL_FROM_NAME=SIGNHEAR
MAIL_SERVER=smtp.example.invalid
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Optional push notification and document conversion settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SOFFICE_PATH=
